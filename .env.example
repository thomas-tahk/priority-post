# --- Required in every environment -------------------------------------------
DATABASE_URL=postgres://user:password@host/db
ANTHROPIC_API_KEY=sk-ant-...
APP_PASSWORD=the-password-you-type-to-open-the-app

# --- The evening digest ------------------------------------------------------
# Without the webhook the app still works; the digest just reports that it has
# nowhere to post. The secret is what stops anyone else triggering a send.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
INTERNAL_API_SECRET=any-long-random-string

# When the digest goes out, and when due-soon pings are allowed. All optional —
# the defaults are 20:00, and pings between 16:00 and 22:00.
APP_TIMEZONE=America/Denver
DIGEST_HOUR=20
DIGEST_MINUTE=0
ACTIVE_START_HOUR=16
ACTIVE_END_HOUR=22

# --- Acting on the factory's items -------------------------------------------
# Reading the factory's list needs nothing (the hub repo is public). This is
# only needed to tap the buttons, and only needs Issues: read and write.
GITHUB_TOKEN=github_pat_...
