# Discord
DISCORD_BOT_TOKEN=[bot_token]
DISCORD_CHANNEL_ID=[channel_id_the_bot_listens_and_posts_in]
OWNER_DISCORD_ID=[your_discord_user_id]

# Web app (the priority-post Vercel deployment)
WEB_BASE_URL=https://priority-post.vercel.app
INTERNAL_API_SECRET=[same_value_set_in_vercel]

# AI
ANTHROPIC_API_KEY=[anthropic_key]

# Behavior
# Evening planning nudge — fires at DIGEST_HOUR:DIGEST_MINUTE local to TZ.
DIGEST_HOUR=16
DIGEST_MINUTE=45

# Due-soon pings are only delivered inside [ACTIVE_START_HOUR, ACTIVE_END_HOUR).
# Outside it they are skipped, not queued. Equal values disable quiet hours.
ACTIVE_START_HOUR=16
ACTIVE_END_HOUR=22

TZ=America/Denver
