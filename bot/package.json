{
  "name": "priority-post-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Discord planner bot for priority-post — proactive alerts + conversational task management.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
